        {"field": "p75", "header": "Q3", "decimals": 2},
        {"field": "min", "header": "Min", "decimals": 2},
        {"field": "max", "header": "Max", "decimals": 2}
      ],
      "notes": "Quartiles use linear interpolation between order statistics (Hyndman--Fan type 7)."
