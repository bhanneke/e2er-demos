      "filename": "groups.tex",
      "label": "tab:groups",
      "caption": "Radius provenance groups in the analysis sample (confirmed planets with a radius and an orbital period)",
      "layout": "records",
      "source": "estimation_results.json",
      "path": "groups",
      "rows": ["calculated", "measured_transiting", "measured_non_transiting", "all"],
      "row_labels": {
        "calculated": "Calculated from mass",
        "measured_transiting": "Measured, transiting",
        "measured_non_transiting": "Measured, not transiting",
        "all": "All"
      },
      "row_header": "Radius provenance",
      "columns": [
        {"field": "count", "header": "$N$", "decimals": 0},
        {"field": "share_of_sample", "header": "Share of sample", "decimals": 3}
      ],
      "notes": "Groups follow the archive's CALCULATED\\_VALUE label in the radius reference and the transit flag. Shares are fractions of the 6,045 planets with both a radius and a period."
    },
    {
