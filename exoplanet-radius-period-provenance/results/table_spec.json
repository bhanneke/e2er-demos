      "layout": "records",
      "source": "estimation_results.json",
      "path": "associations",
      "rows": ["radius_period_all", "radius_period_calculated", "radius_period_measured_transiting", "radius_period_measured_non_transiting", "mass_radius_calculated"],
      "row_labels": {
