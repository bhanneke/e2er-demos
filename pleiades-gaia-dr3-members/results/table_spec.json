      "source": "estimation_results.json",
      "path": "main_sequence_locus",
      "key_field": "g_lower",
      "row_header": "$G$ bin (mag)",
      "columns": [
        {"field": "n", "header": "$N$", "decimals": 0},
        {"field": "p16_bp_rp", "header": "16th pct.", "decimals": 2},
