      "source": "estimation_results.json",
      "path": "membership_grid",
      "key_field": "row",
      "row_header": "Specification",
      "columns": [
        {"field": "n_quality", "header": "Quality sample", "decimals": 0},
        {"field": "n_members", "header": "Members", "decimals": 0},
